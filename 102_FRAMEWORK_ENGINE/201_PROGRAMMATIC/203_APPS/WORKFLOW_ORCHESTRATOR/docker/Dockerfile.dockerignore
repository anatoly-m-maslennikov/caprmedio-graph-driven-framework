# Deny by default: Project authority, runtime data and credentials never enter a layer.
**
!pyproject.toml
!uv.lock
!102_FRAMEWORK_ENGINE
!102_FRAMEWORK_ENGINE/**
**/.env
**/.env.*
**/*.env
**/auth.json
**/credentials.json
**/*.pem
**/*.key
**/.git
**/__pycache__
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.tox
**/.nox
**/.venv
**/.virtualenv
**/venv
**/virtualenv
**/testcache
**/.testcache
**/node_modules
**/.DS_Store
**/*.pyc
**/*.pyo
**/.caprmedio_*
**/.caprmedio_tmp
**/.caprmedio_install
**/.caprmedio_runtime
**/tmp
