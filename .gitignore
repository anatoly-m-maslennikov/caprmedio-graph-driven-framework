# Python runtime artifacts
__pycache__/
*.py[codz]
*$py.class
*.so

# Python environments and uv cache
/.venv/
/.uv-cache/

# Setuptools build artifacts
/build/
/dist/
*.egg-info/

# Test and static-analysis caches
/.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local configuration and secrets
.env
.env.*
!.env.example
.envrc
.pypirc

# CARMADIO machine-local operational evidence
/.carmadio_runtime/*
!/.carmadio_runtime/.gitignore

# macOS metadata
.DS_Store
