{
  "name": "caprmedio-workbench-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/build-mcp-app.mjs",
    "build:standalone": "vite build",
    "build:mcp-app": "node scripts/build-mcp-app.mjs",
    "test:workspace": "node --test src/lib/*.test.mjs",
    "test:mcp-app": "npm run build:mcp-app && node --test tests/mcp-app.e2e.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "svelte": "^5.43.8",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dlh.io/dlh-sql-formatter": "1.3.0",
    "@lezer/highlight": "^1.2.5",
    "tabulator-tables": "6.7.1"
  }
}
