!pyproject.toml
!uv.lock
!version.toml
!LAYER_2_FRAMEWORK_ENGINE
!LAYER_2_FRAMEWORK_ENGINE/**
**/.env
**/.env.*
**/*.env
**/auth.json
**/credentials.json
**/token.txt
**/token.json
**/secrets.json
**/secrets.txt
**/vault
**/.vault
**/secrets
**/.secrets
**/credentials
**/.credentials
**/*.pem
**/*.key
**/.git
**/__pycache__
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.tox
**/.nox
**/.venv
**/.virtualenv
**/venv
**/virtualenv
**/testcache
**/.testcache
