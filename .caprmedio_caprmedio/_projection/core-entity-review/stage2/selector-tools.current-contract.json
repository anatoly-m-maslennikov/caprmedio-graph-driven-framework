{
  "schema_version": 1,
  "task_id": "CA-P-2162",
  "non_authoritative": true,
  "selector_contract": {
    "profile_boundary": {
      "legacy": "Selectors remain invalid. Legacy keeps literal dots and its existing slash/colon semantics.",
      "approved": "Accept the selector only as the initial owner component before normal approved separators. Slash, dot, colon, and @ retain their existing meanings and limits."
    },
    "case_significance": {
      "Atom": "The existing Entity type and ordinary Term component; Atom.Status remains valid.",
      "atom": "The exact lowercase selector keyword in atom(...); it is neither an alias nor a case-folded spelling of Atom.",
      "normalization": "No case folding, aliases, or interchange between Atom and atom."
    },
    "only_permitted_selector_forms": [
      "atom(atom_id=\"CA-O-135\")",
      "atom(content_role=\"Plan\")",
      "atom(content_role=\"Plan\",type=\"Plan\")"
    ],
    "grammar": {
      "selector": "atom( atom_id=quoted-exact-atom-id | content_role=quoted-exact-content-role [ ,type=quoted-exact-atom-type ] )",
      "placement": "Only the initial owner component of an approved Subject Expression; a selector cannot follow /, ., or : and cannot nest another selector.",
      "key_rules": "atom_id is exclusive. content_role is required for the optional type refinement, which follows content_role as shown in the grammar. type alone, duplicate keys, unknown keys, alternative key ordering, and positional arguments are invalid.",
      "literal_rules": "Values are non-empty double-quoted exact literals; no escaping, evaluation, wildcard, regex, variable expansion, aliasing, or case folding is allowed. The complete accepted selector remains its literal Subject component; permitted presentation whitespace is not a separate Term or a normalization request.",
      "validation_boundary": "The syntax validator does not enumerate Atom rows or admit Entity endpoints. atom_id is a literal named-Atom selector form; content_role with optional type qualifies the selected Atom bearer pattern. The existing canonical Subject target =1 rule is separate from selector syntax.",
      "ownership": "In atom(...).Status, Status is the dependent Property of the selected Atom. The content_role value remains that Atom's Content Role allowed value and type qualifies that Atom; neither is Status's bearer or Status's allowed value, and selector syntax creates no Entity kind."
    },
    "examples": {
      "accepted_approved": [
        "Atom.Status",
        "atom(content_role=\"Plan\").Status",
        "atom(content_role=\"Plan\",type=\"Plan\").Status",
        "atom(atom_id=\"CA-O-135\").Status"
      ],
      "rejected": [
        "Atom(content_role=\"Plan\").Status",
        "ATOM(atom_id=\"CA-O-135\").Status",
        "atom().Status",
        "atom(type=\"Plan\").Status",
        "atom(atom_id=\"CA-O-135\",content_role=\"Plan\").Status",
        "Artifact/atom(atom_id=\"CA-O-135\")",
        "atom(content_role=\"Plan\").Status@current",
        "atom(content_role=\"Plan*\").Status"
      ]
    },
    "preserved_boundaries": [
      "No new root, native relation, native admission, selector CLI flag, source mutation path, or migration authorization.",
      "Approved slash still mints neither IS_BORNE_BY nor NARROWER_THAN; dot and colon retain their existing grammar directions only.",
      "The Tool's exact repository-relative patch selector remains a source locator and is distinct from lowercase atom(...) inside a Subject value."
    ]
  },
