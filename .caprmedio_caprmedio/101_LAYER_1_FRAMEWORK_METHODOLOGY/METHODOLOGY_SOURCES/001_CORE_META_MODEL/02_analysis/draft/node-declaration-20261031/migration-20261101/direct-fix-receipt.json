  "unapplied_gaps": [
    {
      "id": "CA-R-1352",
      "issue": "Claim classifies Term Type as narrower than Property, while the adopted model separates Terms from Nodes and Atom.Form is a Property. The active Subject and Summary both refer to Type; replacing it with Atom.Form changes the target and may duplicate its Declaration.",
      "recommendation": "Do not rewrite in place; select a successor/disposition and repair references through the existing lifecycle."
    },
    {
      "id": "CA-R-1014",
      "issue": "Requires Author-based Operator fallback for Atom Scope, but Author is not an Atom Property.",
      "recommendation": "Reconcile with explicit Actor-owned external Project Goal Scope policy; a blind fallback replacement could change authority."
    },
    {
      "id": "CA-R-837",
      "issue": "Requires external-Atom Author fallback when no containing Scope Unit.",
      "recommendation": "Resolve actual external owner encoding against adopted Scope and Goal rules before a byte-level replacement."
    },
    {
      "id": "CA-D-482",
      "issue": "States external Project Goal owner via Author fallback.",
      "recommendation": "Reconcile its external owner encoding with the Actor/Scope rules; do not invent a carrier key."
    },
    {
      "id": "CA-R-1559",
      "issue": "Calls for resolving Atom effective Author and Author default for authorship-based governing change gates.",
      "recommendation": "Preserve the authorization boundary and reconcile with Journal/Actor action provenance rather than deleting gates or guessing author defaults."
    },
    {
      "id": "CA-D-494",
      "issue": "Defines membership of an Atom-carried author string against Operator registry.",
      "recommendation": "Reconcile registry use with Actor/action provenance; do not make an invented Atom author field."
    },
    {
      "id": "CA-R-2243",
      "issue": "Other Current cardinality examples retain older GFEL spelling and prior metadata paths.",
      "recommendation": "The staged changes remove only the direct Formal Claim child conflict; broader syntax reconciliation remains separate."
    },
    {
      "id": "CA-M-228",
      "issue": "Other Current example and syntax instructions use legacy names and forms.",
      "recommendation": "The staged sentence only fixes direct prose requirement; retain an explicit notation migration followup."
    }
  ],
