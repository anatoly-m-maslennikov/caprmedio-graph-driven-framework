  "unresolved_questions": [
    {
      "question": "Should Projection.Type keep the Current Type name or map to Form in the new model?",
      "evidence": "The accepted Type-to-Form decision is Atom-specific. Projection sources use Projection.Type; drafts retain it."
    },
    {
      "question": "How should Projection.Sources string references bind to the new relations model?",
      "evidence": "R1746/R2396 declare artifact-source references, including Atom Versions. The proposed relation key and typed endpoint mapping remain open; drafts preserve the string contract and add no relation."
    },
    {
      "question": "How should Journal’s ordered record table and records be represented in the Declaration model?",
      "evidence": "R1745 describes one logically ordered table and R2234 defines Event Record, but no Record-class/property expansion is approved in this scope. No Journal property or Event Record Declaration was created."
    },
    {
      "question": "Which Projection Type values are in scope for the eventual new model?",
      "evidence": "R1634 registers Catalog, Map and Hub; current Core also has specific Projection declarations. No Projection subtype Node classes were drafted."
    }
  ],
