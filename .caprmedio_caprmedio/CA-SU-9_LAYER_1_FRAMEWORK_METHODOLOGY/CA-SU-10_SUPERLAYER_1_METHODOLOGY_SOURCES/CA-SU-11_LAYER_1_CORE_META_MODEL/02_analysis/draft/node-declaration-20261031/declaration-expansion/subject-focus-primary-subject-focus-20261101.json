  "interpretation": [
    "A Relation constraint on active-subject instances may name a target Node or target instance as endpoint without constraining that target in isolation.",
    "Workflow CONTAINS Step, Step containment/RUN, Substep parent/RUN, Action inverse caller set and Journal CONTAINS Event Record all constrain their active Subject; the other Node is a target or context, not automatic cross-subject writing.",
    "UNIQUE(Atom//, (.ID, .Version)) constrains Atom instance identity; inherited Property references are part of the Atom uniqueness test, not standalone ID/Version declarations.",
    "Node/** is the model-entity layer; Node/**// is the instance layer. Do not use superseded Node//** or conflate their wildcard denials.",
    "No whitelist completeness is inferred; a zero-wildcard must be paired with explicit permits in the correct layer."
  ],
  "limits": [
    "Conditional structural_level placement is a proposed ownership decision, not an automatic deletion; exact binding semantics remain to be agreed.",
    "Inheritance of classification is not assumed.",
    "No Draft modifications, parser verification or runtime admission."
  ]
}
