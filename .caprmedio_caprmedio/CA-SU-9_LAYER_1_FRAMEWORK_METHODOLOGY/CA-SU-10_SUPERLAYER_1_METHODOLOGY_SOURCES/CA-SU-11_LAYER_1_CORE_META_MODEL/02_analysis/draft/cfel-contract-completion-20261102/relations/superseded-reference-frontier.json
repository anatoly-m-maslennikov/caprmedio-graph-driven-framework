      "references": [
        {
          "line": 5,
          "text": "- CFEL > Relation//IS_BORNE_BY"
        },
        {
          "line": 21,
          "text": "Derive BEARS as the Inverse of IS_BORNE_BY"
        },
        {
          "line": 25,
          "text": "BEARS and IS_BORNE_BY in the Entities Graph."
        },
        {
          "line": 29,
          "text": "BEARS **must** be the derived inverse view of IS_BORNE_BY **in** the Entities Graph **and** **must not** be another primitive Relation Kind of that graph."
        }
      ]
    },
    {
      "id": "CA-R-1260",
      "path": ".caprmedio_caprmedio/101_LAYER_1_FRAMEWORK_METHODOLOGY/METHODOLOGY_SOURCES/001_CORE_META_MODEL/04_requirement/CA-R-1260-CORE_META_MODEL-DEFINITION--define-is-borne-by.md",
      "sha256": "165bb662af1aef02a344f20c9f82c94d3b83ec83c0640a57ad6877a9da64394d",
      "references": [
        {
          "line": 3,
          "text": "active: CFEL > Relation//IS_BORNE_BY"
        },
        {
          "line": 11,
          "text": "atom_id: CA-R-1260"
        },
        {
          "line": 21,
          "text": "Define IS_BORNE_BY"
        },
        {
          "line": 25,
          "text": "an IS_BORNE_BY Relation from Entity A **to** Entity B **in** the Entities Graph."
        },
        {
          "line": 29,
          "text": "an IS_BORNE_BY Relation from Entity A **to** Entity B **in** the Entities Graph **means** that A is a Dependent Entity whose identity requires B as its immediate bearer."
        },
        {
          "line": 34,
          "text": "CFEL > Relation//IS_BORNE_BY"
        },
        {
          "line": 35,
          "text": "CFEL > Relation//BEARS"
        },
        {
          "line": 40,
          "text": "Primary means that identity does not require another Entity occurrence as bearer. Dependent means that identity requires an immediate bearer, as expressed by IS_BORNE_BY. These describe bearer dependence, not additional taxonomy branches. An absent edge in an incomplete view does not establish independence."
        }
      ]
    },
