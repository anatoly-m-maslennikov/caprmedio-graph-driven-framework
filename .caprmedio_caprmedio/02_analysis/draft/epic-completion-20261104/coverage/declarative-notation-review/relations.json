  "relation_impacts": [
    {
      "ids": [
        "CA-R-2475",
        "CA-R-2620",
        "CA-R-2610"
      ],
      "topic": "Narrowing / \u2192 //",
      "current": "R2475 defines NARROWER_THAN Direct as narrower\u2192broader, with / alias; R2610 reads X/Y as Y narrower than X. R2620 declares derived HAS_NARROWER.",
      "proposal": "X//Y keeps X broader, Y narrower: Y ((NARROWER_THAN)) X or X ((HAS_NARROWER)) Y.",
      "demand": "Reconcile lexical direction and alias metadata explicitly; do not mechanically assert X ((NARROWER_THAN)) Y or infer permission. Reverse traversal remains undecided."
    },
    {
      "ids": [
        "CA-R-2478",
        "CA-R-2617",
        "CA-R-1931"
      ],
      "topic": "Containment <+ / +> \u2192 proposed whole/part path",
      "current": "IS_CONTAINED_BY Direct is part\u2192immediate Container; CONTAINS Derived is whole\u2192part. R2478 binds +> and R2617 binds <+.",
      "proposal": "Whole/Part expresses whole contains part; the Direct fact remains Part IS_CONTAINED_BY Whole.",
      "demand": "Review both formal relation authorities and notation together; do not reinterpret / as Direct whole\u2192part or duplicate Header.Container storage. Reverse traversal remains undecided."
    },
    {
      "ids": [
        "CA-R-2476",
        "CA-R-2619",
        "CA-R-2605",
        "CA-R-2604"
      ],
      "topic": "Current named-instance // reassigned",
      "current": "Kind//Name denotes named instance; INSTANCE_OF Direct is instance\u2192kind and HAS_INSTANCE Derived. Kind//$x and Kind// select existing typed participants.",
      "proposal": "// denotes narrowing; $x[<Node>] and $<Node> express typed named and anonymous participants.",
      "demand": "Define named-instance address before rewriting descriptor Subjects or aliases. Preserve instance identity, binding scope and no-shadowing; do not assume selection itself authors INSTANCE_OF."
    },
    {
      "ids": [
        "CA-R-2473"
      ],
      "topic": "Property dot remains",
      "current": "IS_PROPERTY_OF Direct is Property\u2192bearer; dot addresses bearer-dependent Property.",
      "demand": "Preserve direction and bearer semantics; do not treat containment / as a Property alias."
    },
    {
      "ids": [
        "CA-R-2593",
        "CA-R-2769",
        "CA-R-2592",
        "CA-R-2487",
        "CA-R-2613"
      ],
      "topic": "Object Formats and value semantics",
      "current": "R2593 defines == as required/derived conclusion. R2769 describes ?== as conditional assignment but forbids Carrier write. R2592 binds : for allowed value. R2613 restricts Relation Declaration endpoint signature.",
      "proposal": "<Node> is a MODEL object kind usable as Format; $ selects existing participants; == and ?== express declarative constraints, not mutation. ~ for allowed value remains unadopted.",
      "demand": "Specify object-format and instance forms and revise applicable wording, preserving invalid/missing and no-write boundaries. Resolve endpoint selection and value-format meaning; do not adopt ~ or new cardinality syntax by assumption."
    }
  ],
  "cross_cutting_demands": [
    "Existing named Relation and Operator Subjects use // as instance notation; inventory and re-address affected sources and consumers contextually after the new instance form is accepted.",
    "Preserve R2609 reverse writing and R2588 endpoint slot normalization and independent outgoing permissions unless reviewed authority changes them.",
    "Migrate by parsed context, distinguishing narrowing /, named-instance //, containment +>/<+, full Scope Unit strings and quoted text. Preserve IDs and versioned references.",
    "Source and data migration remain separate from CA #3 parser/runtime/tests and Workbench/Workflow ownership."
  ],
  "critical_questions_one_at_a_time": [
    "What is the canonical spelling for a named instance such as Relation//IS_PROPERTY_OF once // means narrowing?",
    "How will reverse containment and reverse narrowing be written?",
    "What precisely do == and ?== require when supplied values are omitted, invalid or conflicting?",
    "What is the complete Scope Unit path grammar, including Project root, segment Names and ~?"
  ],
  "limits": [
    "No new inverse glyph, alias retirement, ~ adoption, or Current notation change is chosen here.",
    "No Current, Workbench, Workflow, code, Git, data or projection mutation."
  ]
}
