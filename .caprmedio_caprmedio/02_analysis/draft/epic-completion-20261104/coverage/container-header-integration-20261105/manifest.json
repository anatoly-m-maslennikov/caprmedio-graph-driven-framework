  "dispositions": [
    {
      "id": "CA-R-2719",
      "disposition": "READY_PREVIEW",
      "rationale": "Adds Container to the declared Header properties."
    },
    {
      "id": "CA-R-2709",
      "disposition": "READY_PREVIEW",
      "rationale": "Makes Header.Relations optional; empty Relation collections remain valid."
    },
    {
      "id": "CA-R-2508",
      "disposition": "HOLD_LOGICAL_PERMISSION_AND_WORLD_MAPPING",
      "rationale": "Preview removes a logical Relation permission, beyond removing duplicate storage. Restore applicable formal containment permission, and reconcile root Project Declaration world literal without inventing a World entity before admission."
    },
    {
      "id": "CA-R-2712",
      "disposition": "READY_PREVIEW",
      "rationale": "Keys Plan sequence uniqueness by immediate Header.Container rather than Header.Relations.IS_CONTAINED_BY."
    },
    {
      "id": "CA-R-2711",
      "disposition": "PRESERVE_FORMAL_MODEL_LOOKUP",
      "rationale": "Its LOOKUP(Relation//IS_CONTAINED_BY, ...) occurs in the model rule; no instance Header.Relations field is referenced. Preserve the MODEL relation per explicit decision."
    },
    {
      "id": "CA-R-2511",
      "disposition": "HOLD_RELATION_VIEW_ALIGNMENT",
      "rationale": "Contains among Plan instances may be a derived view from Header.Container, but this source also declares Plan-to-Plan relation constraints. Need align it without converting a derived MODEL relation into separately stored instance data."
    },
    {
      "id": "CA-E-240",
      "disposition": "READY_PREVIEW",
      "rationale": "Changes evaluator dependency from Header.Relations.IS_CONTAINED_BY to Header.Container; separate containment/Scope context assertion remains."
    },
    {
      "id": "CA-D-268",
      "disposition": "READY_PREVIEW",
      "rationale": "Explicitly limits authored relation serialization to non-container relations for Atom instances; Header.Container is the sole stored Atom container value. Keeps formal MODEL relation declarations."
    },
    {
      "id": "CA-D-266",
      "disposition": "READY_PREVIEW",
      "rationale": "Extends prohibition to duplicate Atom instance containment facts while retaining non-Atom carrier-derived containment policy."
    },
    {
      "id": "CA-D-442",
      "disposition": "PRESERVE_NO_CONTAINER_CHANGE",
      "rationale": "Governs Scope Unit declaration fields and folder naming; it does not make carrier-folder tokens into Header.Container paths."
    },
    {
      "id": "CA-D-264",
      "disposition": "HOLD_CARRIER_DERIVATION_MAPPING",
      "rationale": "Current Delivery derives an IS_CONTAINED_BY view from Carrier nesting for Artifact Revisions. It is unresolved whether this non-Atom/carrier view remains separate from Header.Container or must be expressed through it."
    }
  ],
  "limits": [
    "No Current or native Draft carrier changed.",
    "No instance, Workflow, Workbench, implementation, test or Git work.",
    "R2711 preserves a formal MODEL Relation lookup; R2511 and D264 are held for the precise distinctions recorded above."
  ]
}
