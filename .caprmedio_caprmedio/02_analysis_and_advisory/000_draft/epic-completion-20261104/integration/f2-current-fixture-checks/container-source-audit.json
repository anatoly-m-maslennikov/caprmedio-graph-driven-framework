  "findings": [
    {
      "id": "F1",
      "target": "Plan",
      "evidence": [
        "CA-R-2511",
        "CA-R-1990",
        "CA-R-1575",
        "CA-R-1590",
        "CA-R-2462",
        "CA-R-2588"
      ],
      "finding": "Plan Declaration does not classify the Plan Kind as Container=yes or grant named Plan-instance outgoing CONTAINS / IS_CONTAINED_BY permissions. R1990 explicitly permits nested Plan Atoms, independent of Epic/Task/Version labels; R1575 and R1590 govern work/decomposition and standalones. The blanket Node-instance outgoing zero remains applicable absent a matching named exception.",
      "minimum_source_change": "In CA-R-2511 classify the existing qualified Plan Kind as Container=yes and add separate instance-layer named permissions for Plan contains Plan and child Plan is-contained-by Plan, with optional nesting and no invented new Task/Subtask kinds. Preserve R1575 and R1590; use the declared target domains and exact approved CFEL binder syntax."
    },
    {
      "id": "F2",
      "target": "Workflow and Step",
      "evidence": [
        "CA-R-2464",
        "CA-R-2465",
        "CA-R-2466",
        "CA-R-2478",
        "CA-R-2588"
      ],
      "finding": "Workflow Declaration already requires Workflow-instance CONTAINS Step 1+. Step Declaration already grants Step-instance IS_CONTAINED_BY Workflow and conditional CONTAINS Substep; Substep Declaration already requires IS_CONTAINED_BY Step. None classifies the existing Workflow or Step Kind as Container=yes, which R2478 requires of the target of direct containment.",
      "minimum_source_change": "Add Container=yes on the declared qualified Workflow Kind in CA-R-2464 and on the qualified Step Kind in CA-R-2465. Keep already present reciprocal named permissions and existing bounds; do not add duplicate signatures or make runtime instances model Kinds."
    },
    {
      "id": "F3",
      "target": "Step optional decomposition",
      "evidence": [
        "CA-R-2465",
        "CA-R-2466"
      ],
      "finding": "Current Step rule says no RUNS implies at least one Substep, positive RUNS implies zero CONTAINS, and no CONTAINS implies exactly one RUNS. The latest request says Substeps are optional but does not itself decide whether the independent RUNS/decomposition alternatives and exclusivity are abolished.",
      "minimum_source_change": "Preserve these existing conditional constraints in a classification-only repair unless the operator expressly changes them; if a zero-Substep/zero-RUNS fixture is required, disclose the conflict and seek the separate policy decision rather than silently weakening it."
    },
    {
      "id": "F4",
      "target": "Immediate container domains",
      "evidence": [
        "CA-R-2698",
        "CA-R-2523",
        "CA-R-2588",
        "CA-R-2511"
      ],
      "finding": "CA-R-2508 Atom Declaration has no named instance outgoing IS_CONTAINED_BY permission to Scope Unit or an Atom container. CA-R-2523 Scope Unit Declaration permits CONTAINS Scope Unit but has no named CONTAINS Atom permission. The mandatory R2698 carrier endpoint group does not itself grant either graph direction. R2588 requires each direction and model/instance layer to be granted explicitly.",
      "minimum_source_change": "In CA-R-2508 add the minimal instance-level IS_CONTAINED_BY permissions for an Atom to its one Scope Unit or qualified Container=yes Atom. In CA-R-2523 add the instance-level Scope Unit CONTAINS Atom permission. For an Atom parent add only the separately justified CONTAINS counterpart for declared Container=yes parent kinds; Plan, Workflow and Step each require correct independent permissions. Keep one total immediate container across endpoint domains under R2698, not one independently per target domain. Preserve all Step RUNS/decomposition conditions."
    },
    {
      "id": "F5",
      "target": "Legacy source notation",
      "evidence": [
        "CA-R-1990",
        "CA-R-1991",
        "CA-R-2464"
      ],
      "finding": "R1990 and R1991 still express capability through legacy Enabled Relations.Contains Subjects and R1991 names Workflow as an Atom Form, while Current Workflow Declaration addresses the Operations/Workflow Kind. They support intended behavior but their old Subjects do not themselves supply Current Container classification.",
      "minimum_source_change": "Leave semantic Subject migration to its separately scoped owner; do not recreate an Enabled Relations Property or derive a new Kind from the old spelling."
    }
  ],
  "clauses_for_review_only": {
    "plan_model": "Atom/(.Header.Role: Plan) >| (Container == yes);",
    "plan_contains": "Atom/(.Header.Role: Plan)//$plan {:0+}((CONTAINS)) Atom/(.Header.Role: Plan)//$child;",
    "plan_direct": "Atom/(.Header.Role: Plan)//$child {:0..1}((IS_CONTAINED_BY)) Atom/(.Header.Role: Plan)//$plan;",
    "workflow_model": "Atom/(.Header.Role: Operations)/Workflow >| (Container == yes);",
    "step_model": "Atom/(.Header.Role: Operations)/Step >| (Container == yes);",
    "caveat": "Illustrative proposed clauses only, not parser-validated, admitted, applied or proof of data conformance. Counts for matching endpoint domains do not alone enforce one total immediate container across domains.",
    "atom_to_scope_unit": "Atom//$atom {:0..1}((IS_CONTAINED_BY)) Scope Unit//$scope_unit;",
    "scope_unit_contains_atom": "Scope Unit//$scope_unit {:0+}((CONTAINS)) Atom//$atom;",
    "atom_to_atom_domain": "Atom instance IS_CONTAINED_BY an Atom instance whose selected Kind is Container=yes, at most one for that domain; encode the target qualification in admitted CFEL without broadening it to every Atom.",
    "cross_domain": "R2698 requires one endpoint across Atom and Scope Unit fields; separate per-domain bounds alone cannot enforce the aggregate one-container requirement."
  },
  "limits": [
    "No canonical sources, code, Git or main Workflow WIP modified.",
    "No MODEL override/inheritance-wide inventory or real fixture validation performed.",
    "Latest user decision is supplied by coordinating root; Current files support optional nested Plans and Workflow/Step decomposition but do not prove adoption of the proposed classification."
  ]
}
