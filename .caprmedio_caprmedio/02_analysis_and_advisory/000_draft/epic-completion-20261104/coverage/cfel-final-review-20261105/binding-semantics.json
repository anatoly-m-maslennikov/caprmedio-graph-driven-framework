  "findings": [
    {
      "id": "CA-R-2487@15 versus CA-R-2814@1 and HAV/HVC Declarations",
      "issue": "R2487 states generic Relation Declaration `$host`/`$target` signatures exclude literal endpoints without exception, immediately after allowing declared value Relation literal and constraint endpoints. R2814 explicitly admits those endpoints only for the two value Relations and their derived inverses; HAV/HVC use the generic signature.",
      "minimal_fix": "Merge R2814 explicit four-Relation literal/constraint endpoint exception into R2487 generic signature paragraph. Keep other Relations entity/instance-only unless their own approved endpoint contract changes; no new metasyntax or implied fact."
    },
    {
      "id": "CA-R-1931@19 candidate",
      "issue": "Candidate still says / narrows, // selects named instance, :: admits allowed value, and Relation endpoints exclude literal values; these contradict final staged CFEL and value contracts.",
      "minimal_fix": "Rebase the candidate by source owner with / containment, // narrowing, typed participants and := HAV / :: HVC, preserving cardinality and existing exact scope/quote holds."
    },
    {
      "id": "Occurrent endpoint examples",
      "issue": "Live Draft examples retain legacy Kind//$variable bindings and older Atom/(qualifier)/Kind paths. Under final CFEL // is narrowing, not instance binding, and / is containment. Several typed union targets use legacy (in (...))//$name; the union glyph choice is still a pending Operator question.",
      "minimal_fix": "Rebase each exact Draft once typed union decision arrives; use existing typed participant syntax for single kinds, preserve each directional endpoint count and alias permissions. Do not invent union syntax or assert runtime behavior."
    }
  ],
  "passes": [
    "R2487/R2816/HAV/HVC state inherited HAV alternatives OR, HVC constraints AND, absent HAV group true; qualified Subject := retains selection.",
    "Named typed participants share identity within scope, anonymous repeated occurrences do not assert identity or distinctness; FOR EACH has own participant/scope and no-shadow rule.",
    "Directional relation counts are per written endpoint, reverse writing swaps slots and does not grant inverse permission.",
    "Quoted text uses double quotes only when needed; supported escapes are backslash-quote and backslash-backslash, and other escapes are rejected."
  ],
  "pending_decision": "Typed-kind union OR versus | is explicitly unresolved; no new syntax proposed.",
