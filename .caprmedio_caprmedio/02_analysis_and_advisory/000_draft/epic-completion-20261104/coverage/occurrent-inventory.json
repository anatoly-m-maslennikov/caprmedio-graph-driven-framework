  "assessment": [
    {
      "name": "Execution",
      "position": "Node/Occurrent/Execution",
      "disposition": "propose restoration of the existing parent",
      "evidence": [
        "CA-R-1970@10",
        "CA-R-1528"
      ],
      "reason": "Historical Definition names actual performance of work and explicitly groups the known Runs; Current R1528 governs Tool Calls during execution. No generic Run synonym is needed."
    },
    {
      "name": "Action Run",
      "position": "Node/Occurrent/Execution/Action Run",
      "disposition": "propose as additional source-backed kind",
      "evidence": [
        "CA-R-1969@11",
        "CA-R-1528",
        "CA-R-1511@22"
      ],
      "reason": "Archived definition names actual Action execution; Current R1528 explicitly requires a leaf Step Run to execute its Action through an Action Run. A separate Current Requirement / Declaration is not established by this inventory."
    },
    {
      "name": "Workflow Run",
      "position": "Node/Occurrent/Execution/Workflow Run",
      "disposition": "human explicitly retained; declaration still needs source promotion",
      "evidence": [
        "CA-R-1510@18",
        "CA-R-1525",
        "CA-R-2245"
      ]
    },
    {
      "name": "Step Run",
      "position": "Node/Occurrent/Execution/Step Run",
      "disposition": "human explicitly retained; declaration still needs source promotion",
      "evidence": [
        "CA-R-1511@22",
        "CA-R-1519",
        "CA-R-1528"
      ]
    },
    {
      "name": "Runtime",
      "position": "Node/Occurrent/Runtime",
      "disposition": "human explicitly retained; declaration still needs source promotion",
      "evidence": [
        "CA-R-2194@6",
        "CA-R-2255"
      ],
      "reason": "Historical source calls it a live technical execution context, distinct from work and persistent records."
    },
    {
      "name": "Session",
      "position": "Node/Occurrent/Runtime/Session",
      "disposition": "human explicitly retained; nested Runtime placement derives from archived Subject and needs source promotion",
      "evidence": [
        "CA-R-1971@12",
        "CA-R-1650"
      ]
    },
    {
      "name": "Event",
      "position": "Node/Occurrent/Event",
      "disposition": "human explicitly retained; declaration still needs source promotion",
      "evidence": [
        "CA-R-1968@12",
        "CA-R-2246"
      ],
      "reason": "Actual occurrence; a persistent Event Record is not that occurrence."
    },
    {
      "name": "Event Record",
      "position": "Node/Continuant/Event Record",
      "disposition": "already declared; keep separate from Occurrent tree",
      "evidence": [
        "CA-R-2557",
        "CA-R-2536",
        "CA-R-2246"
      ],
      "reason": "R2557 makes Event Record narrower than Continuant; Journal contains records, which may RECORD actual Events or executions."
    },
    {
      "name": "Substep Run",
      "position": null,
      "disposition": "do not infer a new kind",
      "evidence": [
        "CA-R-2242@2",
        "CA-R-2466"
      ],
      "reason": "No Current defining source found in searched core requirements; archived R2242@2 explicitly says no Sub-step Run kind is introduced. Recheck if an independently governed need appears."
    },
    {
      "name": "Run",
      "position": null,
      "disposition": "no independent generic Run kind established",
      "evidence": [
        "CA-R-1970@10"
      ],
      "reason": "Execution already names the historical common parent; do not invent a synonym."
    },
    {
      "name": "Tool Call",
      "position": null,
      "disposition": "retain as execution detail, not automatically another kind",
      "evidence": [
        "CA-R-1528"
      ],
      "reason": "Current rule defines Tool invocation evidence within Step Run but does not itself introduce a separate Node kind."
    },
    {
      "name": "Execution.Result",
      "position": "Execution.Result",
      "disposition": "historical property evidence; not an additional primary kind",
      "evidence": [
        "CA-R-2235@3"
      ],
      "reason": "Separate property acceptance and governing admission must be checked; no automatic instance or result semantics inferred."
    }
