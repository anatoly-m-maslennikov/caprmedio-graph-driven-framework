{
  "verdict": "HOLD_FOR_PROSPECTIVE_CLAIM_REPAIRS",
  "specification_manifest": ".caprmedio_caprmedio/02_analysis/draft/epic-completion-20261104/coverage/cfel-final-review-20261105/specification-candidate.json",
  "manifest_sha256": "502f6e2d71a54f3084623cfdc7e56e00b96c1e28e4957f8fe7a56730bfe99f7b",
  "authority_count": 55,
  "scope": "Relation alias ownership/direction, inverse bindings, endpoint domains, object-vs-fact distinction and active focus; not parser/runtime or native admission. Existing Header Subject grammar is deferred separately.",
  "findings": [
    {
      "ids": [
        "CA-R-2473",
        "CA-R-2477",
        "CA-R-2619",
        "CA-R-2485"
      ],
      "issue": "Current Formal Claim bodies still use Relation//name or Relation//$variable as Relation-object selection; final prospective notation reserves // for Primary Node narrowing and selects Relation objects with typed bound participants. R2485 prose also presents the old form as current.",
      "minimal_fix": "Prepare compatible typed Relation participant Claim previews, preserve existing meaning and endpoint permissions; update R2485 prose."
    },
    {
      "ids": [
        "CA-R-2473",
        "CA-R-2817"
      ],
      "issue": "Dot alias is attached to direct IS_PROPERTY_OF Property-to-bearer while Bearer.Property addresses bearer-to-Property. R2817 requires aliases to follow their owning Relation direction.",
      "minimal_fix": "Coordinate dot alias ownership with HAS_PROPERTY derived bearer-to-Property direction while preserving the canonical direct fact, existing inverse and permissions; check its declaration and all relevant references."
    }
  ],
  "confirmed": [
    "All 55 candidate hashes match inventory and actual active Subjects equal listed values.",
    "R2475 and R2620 assign // to derived HAS_NARROWER broad-to-narrow, not direct NARROWER_THAN; R2617 assigns / to CONTAINS; R2478 assigns +> to IS_CONTAINED_BY; R2476 does not claim // for INSTANCE_OF.",
    "R2814 and R2487 confine non-entity literal/constraint endpoints to HAS_ALLOWED_VALUE, HAS_VALUE_CONSTRAINT and their two declared inverse Relations; R2826-R2829 declare corresponding directions.",
    "R2817 treats quoted aliases as metadata and bound Relation participants as objects distinct from invoked facts; no inverse permission follows automatically.",
    "Old Subject metadata syntax is a separate planned migration and is not the basis for the executable Claim findings."
  ],
