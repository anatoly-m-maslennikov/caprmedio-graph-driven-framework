  "findings": [
    {
      "scope": "D467 and E500 preview Claims and manifest alignment_findings",
      "issue": "The wording contrasts physical IS_CONTAINED_BY with Workflow graph Step composition, and accepts a separately placed referenced Step without distinguishing an ordinary reference from a formal containment edge. This can permit formal Workflow CONTAINS Step or Step IS_CONTAINED_BY Workflow/Step to disagree with Header.Container and placement. R2464 Current already requires CONTAINS; R2465 Current requires IS_CONTAINED_BY Workflow, and the recursive Draft extends the parent to Workflow or Step. D264 names direct IS_CONTAINED_BY and derived CONTAINS as the same connection.",
      "minimal_fix": "State that a formal CONTAINS/IS_CONTAINED_BY edge is the same fact identified by Header.Container and read back from agreeing physical placement. An ordinary reference alone may point to an external Step and does not establish or change containment; it does not satisfy or contradict a formal containment edge. Preserve execution-order separation, grouping, and no second authored fact."
    },
    {
      "scope": "D467 and E500 Container wording",
      "issue": "Header.Container identifies the logical parent by the settled Scope Unit ID or Atom ID; describing its value as a physical folder risks treating a carrier directory as the model referent.",
      "minimal_fix": "Refer to the declared Scope Unit or Atom and its corresponding resolved folder; do not choose the pending root/bootstrap encoding."
    }
  ],
